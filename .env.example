# Neon Postgres. Use the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/tuneboxd?sslmode=require

# Single-owner login. Username is optional and defaults to "owner".
APP_USERNAME=owner
# Run `pnpm hash-password` to generate this line. Plain APP_PASSWORD also works
# but is less safe.
APP_PASSWORD_HASH=
# APP_PASSWORD=

# Signs the 30-day session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: protects /api/cron/lastfm. Vercel sends it as a bearer token.
CRON_SECRET=
